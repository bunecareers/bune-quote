# All optional for local development.

# Public address of the site, used for canonical URLs, the sitemap and sharing images.
# NEXT_PUBLIC_SITE_URL=https://quote.buneautomation.com

# Where offer request notifications go. Set it as a Worker secret on Cloudflare.
# Storage (D1, shared with buneautomation.com) and sending (Email Service) use
# the bindings in wrangler.jsonc.
LEAD_NOTIFY_EMAIL=
