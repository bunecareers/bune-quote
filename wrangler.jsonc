{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "bune-quote",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bune-quote"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bune-automation-leads",
      "database_id": "03182163-2a97-4d6b-821a-b2fe728d2c2f"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "MAIL_FROM": "hello@buneautomation.com"
  },
  "observability": {
    "enabled": true
  }
}
